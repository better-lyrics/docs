---
import { CODE_LANGUAGES, type CodeLanguage } from '../codeLanguages';

interface Props {
  tabs: { language: CodeLanguage; code: string }[];
}

const { tabs } = Astro.props;
---

<div class="code-tabs" data-code-tabs>
  <div class="code-tabs-header" role="tablist">
    <span class="code-tabs-indicator" aria-hidden="true"></span>
    {tabs.map((tab, i) => (
      <button
        type="button"
        role="tab"
        class="code-tabs-tab"
        data-language={tab.language}
        aria-selected={i === 0 ? 'true' : 'false'}
      >
        {CODE_LANGUAGES[tab.language].label}
      </button>
    ))}
  </div>
  {tabs.map((tab, i) => (
    <pre data-language={tab.language} hidden={i !== 0}><code class={`language-${CODE_LANGUAGES[tab.language].prism}`}>{tab.code}</code></pre>
  ))}
</div>

<script>
  import { CODE_LANGUAGE_STORAGE_KEY } from '../codeLanguages';

  function placeIndicator(group: HTMLElement, animate: boolean) {
    const indicator = group.querySelector<HTMLElement>('.code-tabs-indicator');
    const active = group.querySelector<HTMLElement>('.code-tabs-tab[aria-selected="true"]');
    if (!indicator || !active) return;
    indicator.classList.toggle('animate', animate);
    indicator.style.transform = `translateX(${active.offsetLeft}px)`;
    indicator.style.width = `${active.offsetWidth}px`;
    indicator.style.opacity = '1';
  }

  function select(language: string, animate = true) {
    document.querySelectorAll<HTMLElement>('[data-code-tabs]').forEach((group) => {
      if (!group.querySelector(`pre[data-language="${language}"]`)) return;
      group.querySelectorAll<HTMLElement>('.code-tabs-tab').forEach((tab) => {
        tab.setAttribute('aria-selected', String(tab.dataset.language === language));
      });
      placeIndicator(group, animate);
      group.querySelectorAll<HTMLElement>('pre[data-language]').forEach((pre) => {
        pre.hidden = pre.dataset.language !== language;
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-code-tabs]').forEach((group) => {
    placeIndicator(group, false);
    const header = group.querySelector('.code-tabs-header');
    if (header) new ResizeObserver(() => placeIndicator(group, false)).observe(header);
  });

  const saved = localStorage.getItem(CODE_LANGUAGE_STORAGE_KEY);
  if (saved) select(saved, false);

  document.querySelectorAll<HTMLElement>('.code-tabs-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      const language = tab.dataset.language;
      if (!language) return;
      localStorage.setItem(CODE_LANGUAGE_STORAGE_KEY, language);
      select(language);
    });
  });
</script>

<style>
  .code-tabs {
    margin: var(--space-4) 0;
    background-color: var(--surface-code);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .code-tabs-header {
    position: relative;
    display: flex;
    gap: var(--space-4);
    padding: 0 var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    overflow-x: auto;
  }

  .code-tabs-indicator {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    border-radius: var(--radius-full);
    background-color: var(--text-primary);
    opacity: 0;
    pointer-events: none;
  }

  .code-tabs-indicator.animate {
    transition: transform 260ms cubic-bezier(0.2, 0, 0, 1), width 260ms cubic-bezier(0.2, 0, 0, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .code-tabs-indicator.animate {
      transition: none;
    }
  }

  .code-tabs-tab {
    padding: var(--space-2) 0;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .code-tabs-tab:hover {
    color: var(--text-secondary);
  }

  .code-tabs-tab[aria-selected='true'] {
    color: var(--text-primary);
  }

  .code-tabs pre {
    margin: 0;
    border: none;
    border-radius: 0;
    background: none;
  }
</style>
