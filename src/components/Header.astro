---
import { currentPathOf, headerLinks } from '../nav';

const currentPath = currentPathOf(Astro.url);
---

<header class="header">
  <div class="header-content">
    <a href="/" class="logo">
      <img src="/favicon.svg" alt="" width="20" height="20" loading="eager" />
      <span>Better Lyrics Docs</span>
    </a>

    <nav class="nav">
      {headerLinks.map(link => (
        <a
          href={link.href}
          class:list={['nav-link', { active: link.match(currentPath) }]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-height);
    background-color: rgba(15, 14, 19, 0.8);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .header-content {
    height: 100%;
    padding: 0 var(--space-6);
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    transition: opacity var(--transition-fast);
  }

  .logo:hover {
    color: var(--text-primary);
    opacity: 0.8;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav-link {
    padding: 0.375rem var(--space-3);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--text-primary);
    background-color: var(--bg-tertiary);
  }

  .nav-link.active {
    color: var(--text-primary);
    background-color: var(--bg-secondary);
  }

  @media (max-width: 1024px) {
    .nav {
      display: none;
    }
  }
</style>
