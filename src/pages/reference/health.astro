---
import CodeTabs from '../../components/CodeTabs.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import FieldsTable from '../../components/openapi/FieldsTable.astro';
---

<DocsLayout title="GET /health">
  <p class="endpoint-badge">
    <span class="method">GET</span>
    <code>/health</code>
  </p>

  <p><a class="try-it" href="https://api.betterlyrics.org/health" target="_blank" rel="noopener noreferrer">Open /health</a></p>

  <p>
    Check whether the API is healthy. Always returns <code>200 OK</code>, so read the <code>status</code> field for the result.
    With the cache access token, the response also lists the status of each upstream token.
  </p>

  <h2>Headers (optional)</h2>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Required</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>Authorization</code></td>
        <td>No</td>
        <td>Cache access token for detailed status</td>
      </tr>
    </tbody>
  </table>

  <h2>Example request (basic)</h2>
  <CodeTabs tabs={[
    { language: 'curl', code: `curl "https://api.betterlyrics.org/health"` },
    { language: 'javascript', code: `const res = await fetch("https://api.betterlyrics.org/health");
const data = await res.json();` },
    { language: 'python', code: `import requests

res = requests.get("https://api.betterlyrics.org/health")
data = res.json()` },
    { language: 'go', code: `package main

import (
	"fmt"
	"io"
	"net/http"
)

func main() {
	res, err := http.Get("https://api.betterlyrics.org/health")
	if err != nil {
		panic(err)
	}
	defer res.Body.Close()

	body, err := io.ReadAll(res.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(string(body))
}` },
  ]} />

  <h2>Basic response</h2>
  <p>Status: <code>200 OK</code>, <code>Content-Type: application/json</code></p>
  <pre><code class="language-json">{`{
  "status": "ok",
  "accounts": 2,
  "accounts_active": 2,
  "accounts_out_of_service": 0,
  "circuit_breaker": "CLOSED",
  "cache_ready": true
}`}</code></pre>

  <h2>Response fields</h2>
  <FieldsTable
    path="/health"
    describe={{
      accounts: 'Number of configured upstream accounts.',
      accounts_active: 'Accounts that are in service.',
      accounts_out_of_service: 'Accounts that are configured but out of service.',
      cache_ready: 'Whether the cache is ready.',
      'tokens[].name': '`shared_bearer_token` for the shared token, or the account name.',
      'tokens[].type': '`bearer` for the shared token, `mut` for an account token.',
      'tokens[].status': 'See the token status values below.',
      'tokens[].expires': 'Expiry time as `YYYY-MM-DD HH:MM:SS`. `bearer` only, when initialized.',
      'tokens[].remaining_minutes': 'Minutes until expiry. `bearer` only, when initialized.',
      'tokens[].last_checked': 'Time of the last health check (RFC 3339). `mut` only, after a check has run.',
      'tokens[].last_error': 'Error from the last health check. Only when `status` is `unhealthy`.',
      'tokens[].reason': 'Why the account is out of service. Only when `status` is `out_of_service`.',
      'tokens[].note': 'Only when `status` is `unknown`.',
    }}
  />

  <h2>Status values</h2>
  <table>
    <thead>
      <tr>
        <th>Status</th>
        <th>Meaning</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>ok</code></td>
        <td>All systems operational</td>
      </tr>
      <tr>
        <td><code>degraded</code></td>
        <td>The circuit breaker is <code>OPEN</code>. With the cache access token, also when an account token is <code>unhealthy</code>.</td>
      </tr>
      <tr>
        <td><code>unhealthy</code></td>
        <td>No account is in service (none configured, or all out of service). See <code>error</code>.</td>
      </tr>
    </tbody>
  </table>
  <p class="note">
    Token checks affect <code>status</code> only when the request has the cache access token, so an
    authenticated request can report <code>degraded</code> while a basic request reports <code>ok</code>.
  </p>

  <h2>Authenticated response</h2>
  <p>With the <code>Authorization</code> header, the response includes more detail:</p>
  <CodeTabs tabs={[
    { language: 'curl', code: `curl -H "Authorization: your-cache-token" \\
  "https://api.betterlyrics.org/health"` },
    { language: 'javascript', code: `const res = await fetch("https://api.betterlyrics.org/health", {
  headers: { "Authorization": "your-cache-token" },
});
const data = await res.json();` },
    { language: 'python', code: `import requests

res = requests.get(
    "https://api.betterlyrics.org/health",
    headers={"Authorization": "your-cache-token"},
)
data = res.json()` },
    { language: 'go', code: `package main

import (
	"fmt"
	"io"
	"net/http"
)

func main() {
	req, err := http.NewRequest(http.MethodGet, "https://api.betterlyrics.org/health", nil)
	if err != nil {
		panic(err)
	}
	req.Header.Set("Authorization", "your-cache-token")

	res, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer res.Body.Close()

	body, err := io.ReadAll(res.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(string(body))
}` },
  ]} />

  <pre><code class="language-json">{`{
  "status": "ok",
  "accounts": 2,
  "accounts_active": 2,
  "accounts_out_of_service": 0,
  "circuit_breaker": "CLOSED",
  "cache_ready": true,
  "circuit_breaker_failures": 0,
  "tokens": [
    {
      "name": "shared_bearer_token",
      "type": "bearer",
      "status": "healthy",
      "expires": "2026-09-30 12:00:00",
      "remaining_minutes": 10080
    },
    {
      "name": "account-1",
      "type": "mut",
      "status": "healthy",
      "last_checked": "2026-09-23T11:00:00Z"
    },
    {
      "name": "account-2",
      "type": "mut",
      "status": "unknown",
      "note": "health check not yet run"
    }
  ]
}`}</code></pre>

  <h2 id="token-status-values">Token status values</h2>
  <table>
    <thead>
      <tr>
        <th>Status</th>
        <th>Type</th>
        <th>Meaning</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>healthy</code></td>
        <td><code>bearer</code>, <code>mut</code></td>
        <td>Token is valid</td>
      </tr>
      <tr>
        <td><code>refreshing_soon</code></td>
        <td><code>bearer</code></td>
        <td>Token is valid and will be refreshed soon</td>
      </tr>
      <tr>
        <td><code>not_initialized</code></td>
        <td><code>bearer</code></td>
        <td>Token has not been fetched yet</td>
      </tr>
      <tr>
        <td><code>unhealthy</code></td>
        <td><code>mut</code></td>
        <td>The last health check failed. See <code>last_error</code>.</td>
      </tr>
      <tr>
        <td><code>out_of_service</code></td>
        <td><code>mut</code></td>
        <td>Account has no credentials and is not used</td>
      </tr>
      <tr>
        <td><code>unknown</code></td>
        <td><code>mut</code></td>
        <td>No health check has run yet</td>
      </tr>
    </tbody>
  </table>

  <h2>Use cases</h2>
  <ul>
    <li>Health checks in your own monitoring</li>
    <li>Checking that the API is reachable and working while you debug</li>
    <li>Showing API status on a status page or in your app</li>
  </ul>
</DocsLayout>
