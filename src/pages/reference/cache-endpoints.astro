<DocsLayout title="Cache endpoints">
  <p>
    Admin endpoints for inspecting and managing the cache.
    All endpoints except <code>/cache/help</code> and <code>/cache</code> require the <code>Authorization</code> header
    with the cache access token, sent as is with no <code>Bearer</code> prefix. A missing or wrong token returns
    <code>401</code> with the plain text body <code>Unauthorized</code>.
  </p>

  <h2>Authentication</h2>
  <CodeTabs tabs={[
    { language: 'curl', code: `curl -H "Authorization: your-cache-token" \\
  "https://api.betterlyrics.org/cache/keys"` },
    { language: 'javascript', code: `const res = await fetch("https://api.betterlyrics.org/cache/keys", {
  headers: { "Authorization": "your-cache-token" },
});
const data = await res.json();` },
    { language: 'python', code: `import requests

res = requests.get(
    "https://api.betterlyrics.org/cache/keys",
    headers={"Authorization": "your-cache-token"},
)
data = res.json()` },
    { language: 'go', code: `package main

import (
	"fmt"
	"io"
	"net/http"
)

func main() {
	req, err := http.NewRequest(http.MethodGet, "https://api.betterlyrics.org/cache/keys", nil)
	if err != nil {
		panic(err)
	}
	req.Header.Set("Authorization", "your-cache-token")

	res, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer res.Body.Close()

	body, err := io.ReadAll(res.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(string(body))
}` },
  ]} />

  <h2>Endpoints overview</h2>
  <table>
    <thead>
      <tr>
        <th>Endpoint</th>
        <th>Description</th>
        <th>Auth required</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>GET /cache/help</code></td>
        <td>Documentation for cache endpoints</td>
        <td>No</td>
      </tr>
      <tr>
        <td><code>GET /cache</code></td>
        <td>Removed. Returns <code>410 Gone</code> with a list of alternatives</td>
        <td>No</td>
      </tr>
      <tr>
        <td><code>GET /cache/lookup</code></td>
        <td>Check if a song is cached</td>
        <td>Yes</td>
      </tr>
      <tr>
        <td><code>GET /cache/keys</code></td>
        <td>List and search cache keys</td>
        <td>Yes</td>
      </tr>
      <tr>
        <td><code>GET /cache/debug</code></td>
        <td>Inspect a specific cache entry</td>
        <td>Yes</td>
      </tr>
      <tr>
        <td><code>GET /cache/clear</code></td>
        <td>Clear all cached lyrics and negative entries</td>
        <td>Yes</td>
      </tr>
      <tr>
        <td><code>GET /cache/clear/{`{provider}`}</code></td>
        <td>Clear cached lyrics and negative entries for one provider</td>
        <td>Yes</td>
      </tr>
      <tr>
        <td>
          <code>GET /cache/backup</code>, <code>/cache/backups</code>, <code>/cache/restore</code>,
          <code>/cache/dump</code>, <code>/cache/migrate</code>, <code>/cache/migrate/status</code>
        </td>
        <td>Removed. Return <code>410 Gone</code>. See <a href="#removed-endpoints">Removed endpoints</a></td>
        <td>Yes</td>
      </tr>
    </tbody>
  </table>

  <h2>GET /cache/lookup</h2>
  <p>
    Check if lyrics are cached for a specific song. This checks the cache keys that <code>/getLyrics</code> uses,
    with the exact duration (no duration tolerance).
  </p>

  <h3>Parameters</h3>
  <ParamsTable path="/cache/lookup" />
  <p>
    Send all four: the cache keys include album and duration, so a lookup without them checks a different key
    than the one your lyrics requests use. The API rejects a request with <code>400</code> only when both song and
    artist are missing:
  </p>
  <pre><code class="language-json">{`{
  "error": "Provide at least song (s) or artist (a) parameter"
}`}</code></pre>

  <h3>Example</h3>
  <CodeTabs tabs={[
    { language: 'curl', code: `curl -H "Authorization: token" \\
  "https://api.betterlyrics.org/cache/lookup?s=E85&a=Don%20Toliver&al=OCTANE&d=154"` },
    { language: 'javascript', code: `const res = await fetch("https://api.betterlyrics.org/cache/lookup?s=E85&a=Don%20Toliver&al=OCTANE&d=154", {
  headers: { "Authorization": "token" },
});
const data = await res.json();` },
    { language: 'python', code: `import requests

res = requests.get(
    "https://api.betterlyrics.org/cache/lookup?s=E85&a=Don%20Toliver&al=OCTANE&d=154",
    headers={"Authorization": "token"},
)
data = res.json()` },
    { language: 'go', code: `package main

import (
	"fmt"
	"io"
	"net/http"
)

func main() {
	req, err := http.NewRequest(http.MethodGet, "https://api.betterlyrics.org/cache/lookup?s=E85&a=Don%20Toliver&al=OCTANE&d=154", nil)
	if err != nil {
		panic(err)
	}
	req.Header.Set("Authorization", "token")

	res, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer res.Body.Close()

	body, err := io.ReadAll(res.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(string(body))
}` },
  ]} />

  <pre><code class="language-json">{`{
  "query": {
    "song": "E85",
    "artist": "Don Toliver",
    "album": "OCTANE",
    "duration": "154"
  },
  "normalized_key": "ttml_lyrics:e85 don toliver octane 154s",
  "legacy_key": "ttml_lyrics:E85 Don Toliver OCTANE 154s",
  "keys_differ": true,
  "found": true,
  "found_in": "normalized",
  "track_duration_ms": 153181,
  "score": 0.97,
  "language": "en",
  "isRTL": false,
  "ttml_length": 17060,
  "ttml_preview": "<?xml version=\\"1.0\\" encoding=\\"UTF-8\\"?>..."
}`}</code></pre>

  <h3>Response fields</h3>
  <FieldsTable
    path="/cache/lookup"
    describe={{
      query: 'The `song`, `artist`, `album` and `duration` values as received.',
      normalized_key: 'Cache key in the current format (lowercase, trimmed).',
      legacy_key: 'Cache key in the older format (original case, not trimmed).',
      keys_differ: 'Whether the two keys are different.',
      found: 'Whether lyrics are cached under either key.',
      found_in: 'Only when `found` is `true`.',
      note: 'Set when the entry was found under the legacy key.',
      track_duration_ms: 'Stored metadata of the entry. Only when `found` is `true`.',
      language: 'Stored metadata of the entry. Only when `found` is `true`.',
      isRTL: 'Stored metadata of the entry. Only when `found` is `true`.',
      ttml_length: 'Length of the stored lyrics. Only when `found` is `true`.',
      negative_cache: 'Set when no lyrics are cached but a negative entry exists.',
      negative_reason: 'Set when no lyrics are cached but a negative entry exists.',
      negative_cache_in: 'Set when the negative entry was found under the legacy key.',
      'query.song': 'As received.',
      'query.artist': 'As received.',
      'query.album': 'As received.',
      'query.duration': 'As received.',
    }}
  />

