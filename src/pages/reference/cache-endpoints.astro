)

func main() {
	req, err := http.NewRequest(http.MethodGet, "https://api.betterlyrics.org/cache/debug?key=ttml_lyrics:shape%20of%20you%20ed%20sheeran", nil)
	if err != nil {
		panic(err)
	}
	req.Header.Set("Authorization", "token")

	res, err := http.DefaultClient.Do(req)
	if err != nil {
