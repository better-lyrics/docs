<DocsLayout title="Cache endpoints">
  <p>
    Admin endpoints for inspecting and managing the cache.
    All endpoints except <code>/cache/help</code> and <code>/cache</code> require the <code>Authorization</code> header
    with the cache access token, sent as is with no <code>Bearer</code> prefix. A missing or wrong token returns
    <code>401</code> with the plain text body <code>Unauthorized</code>.
  </p>

  <h2>Authentication</h2>
  <CodeTabs tabs={[
    { language: 'curl', code: `curl -H "Authorization: your-cache-token" \\
  "https://api.betterlyrics.org/cache/keys"` },
    { language: 'javascript', code: `const res = await fetch("https://api.betterlyrics.org/cache/keys", {
  headers: { "Authorization": "your-cache-token" },
});
const data = await res.json();` },
    { language: 'python', code: `import requests

res = requests.get(
    "https://api.betterlyrics.org/cache/keys",
    headers={"Authorization": "your-cache-token"},
)
data = res.json()` },
    { language: 'go', code: `package main

import (
	"fmt"
	"io"
	"net/http"
)

func main() {
	req, err := http.NewRequest(http.MethodGet, "https://api.betterlyrics.org/cache/keys", nil)
	if err != nil {
		panic(err)
	}
	req.Header.Set("Authorization", "your-cache-token")

	res, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer res.Body.Close()

	body, err := io.ReadAll(res.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(string(body))
}` },
  ]} />

  <h2>Endpoints overview</h2>
  <table>
    <thead>
      <tr>
        <th>Endpoint</th>
        <th>Description</th>
        <th>Auth required</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>GET /cache/help</code></td>
        <td>Documentation for cache endpoints</td>
        <td>No</td>
      </tr>
      <tr>
        <td><code>GET /cache</code></td>
        <td>Removed. Returns <code>410 Gone</code> with a list of alternatives</td>
        <td>No</td>
      </tr>
      <tr>
        <td><code>GET /cache/lookup</code></td>
        <td>Check if a song is cached</td>
        <td>Yes</td>
      </tr>
      <tr>
        <td><code>GET /cache/keys</code></td>
        <td>List and search cache keys</td>
        <td>Yes</td>
      </tr>
      <tr>
        <td><code>GET /cache/debug</code></td>
        <td>Inspect a specific cache entry</td>
        <td>Yes</td>
      </tr>
      <tr>
        <td><code>GET /cache/clear</code></td>
        <td>Clear all cached lyrics and negative entries</td>
        <td>Yes</td>
      </tr>
      <tr>
        <td><code>GET /cache/clear/{`{provider}`}</code></td>
        <td>Clear cached lyrics and negative entries for one provider</td>
        <td>Yes</td>
      </tr>
      <tr>
        <td>
          <code>GET /cache/backup</code>, <code>/cache/backups</code>, <code>/cache/restore</code>,
          <code>/cache/dump</code>, <code>/cache/migrate</code>, <code>/cache/migrate/status</code>
        </td>
        <td>Removed. Return <code>410 Gone</code>. See <a href="#removed-endpoints">Removed endpoints</a></td>
        <td>Yes</td>
      </tr>
    </tbody>
  </table>

  <h2>GET /cache/lookup</h2>
  <p>
    Check if lyrics are cached for a specific song. This checks the cache keys that <code>/getLyrics</code> uses,
    with the exact duration (no duration tolerance).
  </p>

  <h3>Parameters</h3>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>s</code>, <code>song</code>, <code>songName</code></td>
        <td>Song name</td>
      </tr>
      <tr>
        <td><code>a</code>, <code>artist</code>, <code>artistName</code></td>
        <td>Artist name</td>
      </tr>
      <tr>
        <td><code>al</code>, <code>album</code>, <code>albumName</code></td>
        <td>Album name (optional)</td>
      </tr>
      <tr>
        <td><code>d</code>, <code>duration</code></td>
        <td>Duration in whole seconds (optional)</td>
      </tr>
    </tbody>
  </table>
  <p>Send at least one of song or artist. Otherwise the response is <code>400</code>:</p>
  <pre><code class="language-json">{`{
  "error": "Provide at least song (s) or artist (a) parameter"
}`}</code></pre>

  <h3>Example</h3>
  <CodeTabs tabs={[
    { language: 'curl', code: `curl -H "Authorization: token" \\
  "https://api.betterlyrics.org/cache/lookup?s=Shape%20of%20You&a=Ed%20Sheeran"` },
    { language: 'javascript', code: `const res = await fetch("https://api.betterlyrics.org/cache/lookup?s=Shape%20of%20You&a=Ed%20Sheeran", {
  headers: { "Authorization": "token" },
});
const data = await res.json();` },
    { language: 'python', code: `import requests

res = requests.get(
    "https://api.betterlyrics.org/cache/lookup?s=Shape%20of%20You&a=Ed%20Sheeran",
    headers={"Authorization": "token"},
)
data = res.json()` },
    { language: 'go', code: `package main

import (
	"fmt"
	"io"
	"net/http"
)

func main() {
	req, err := http.NewRequest(http.MethodGet, "https://api.betterlyrics.org/cache/lookup?s=Shape%20of%20You&a=Ed%20Sheeran", nil)
	if err != nil {
		panic(err)
	}
	req.Header.Set("Authorization", "token")

	res, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer res.Body.Close()

	body, err := io.ReadAll(res.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(string(body))
}` },
  ]} />

  <pre><code class="language-json">{`{
  "query": {
    "song": "Shape of You",
    "artist": "Ed Sheeran",
    "album": "",
    "duration": ""
  },
  "normalized_key": "ttml_lyrics:shape of you ed sheeran",
  "legacy_key": "ttml_lyrics:Shape of You Ed Sheeran ",
  "keys_differ": true,
  "found": true,
  "found_in": "normalized",
  "track_duration_ms": 233712,
  "score": 0.97,
  "language": "en",
  "isRTL": false,
  "ttml_length": 45678,
  "ttml_preview": "<?xml version=\\"1.0\\" encoding=\\"UTF-8\\"?>..."
}`}</code></pre>

  <h3>Response fields</h3>
  <table>
    <thead>
      <tr>
        <th>Field</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>query</code></td>
        <td>The <code>song</code>, <code>artist</code>, <code>album</code> and <code>duration</code> values as received</td>
      </tr>
      <tr>
        <td><code>normalized_key</code></td>
        <td>Cache key in the current format (lowercase, trimmed)</td>
      </tr>
      <tr>
        <td><code>legacy_key</code></td>
        <td>Cache key in the older format (original case, not trimmed)</td>
      </tr>
      <tr>
        <td><code>keys_differ</code></td>
        <td>Whether the two keys are different</td>
      </tr>
      <tr>
        <td><code>found</code></td>
        <td>Whether lyrics are cached under either key</td>
      </tr>
      <tr>
        <td><code>found_in</code></td>
        <td><code>normalized</code> or <code>legacy</code>. Only when <code>found</code> is <code>true</code>.</td>
      </tr>
      <tr>
        <td><code>note</code></td>
        <td>Set when the entry was found under the legacy key</td>
      </tr>
      <tr>
        <td><code>track_duration_ms</code>, <code>score</code>, <code>language</code>, <code>isRTL</code></td>
        <td>Stored metadata of the entry. Only when <code>found</code> is <code>true</code>.</td>
      </tr>
      <tr>
        <td><code>ttml_length</code>, <code>ttml_preview</code></td>
        <td>Length of the stored lyrics and their first 200 characters. Only when <code>found</code> is <code>true</code>.</td>
      </tr>
      <tr>
        <td><code>negative_cache</code>, <code>negative_reason</code></td>
        <td>Set when no lyrics are cached but a negative entry exists</td>
      </tr>
      <tr>
        <td><code>negative_cache_in</code></td>
        <td><code>legacy</code> when the negative entry was found under the legacy key</td>
      </tr>
    </tbody>
  </table>

  <h2>GET /cache/keys</h2>
  <p>List and search cache keys.</p>

  <h3>Parameters</h3>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>prefix</code></td>
        <td>Only keys that start with this string (case-sensitive)</td>
      </tr>
      <tr>
        <td><code>contains</code></td>
        <td>Only keys that contain this string (not case-sensitive)</td>
      </tr>
      <tr>
        <td><code>limit</code></td>
        <td>Maximum results (default 100, max 1000)</td>
      </tr>
    </tbody>
  </table>

  <h3>Example</h3>
  <CodeTabs tabs={[
    { language: 'curl', code: `curl -H "Authorization: token" \\
  "https://api.betterlyrics.org/cache/keys?contains=taylor&limit=10"` },
    { language: 'javascript', code: `const res = await fetch("https://api.betterlyrics.org/cache/keys?contains=taylor&limit=10", {
  headers: { "Authorization": "token" },
});
const data = await res.json();` },
    { language: 'python', code: `import requests

res = requests.get(
    "https://api.betterlyrics.org/cache/keys?contains=taylor&limit=10",
    headers={"Authorization": "token"},
)
data = res.json()` },
    { language: 'go', code: `package main

import (
	"fmt"
	"io"
	"net/http"
)

func main() {
	req, err := http.NewRequest(http.MethodGet, "https://api.betterlyrics.org/cache/keys?contains=taylor&limit=10", nil)
	if err != nil {
		panic(err)
	}
	req.Header.Set("Authorization", "token")

	res, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer res.Body.Close()

	body, err := io.ReadAll(res.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(string(body))
}` },
  ]} />

  <pre><code class="language-json">{`{
  "total_keys": 42,
  "matched_keys": 10,
  "limit": 10,
  "keys": [
    {
      "key": "ttml_lyrics:love story taylor swift",
      "size": 38211,
      "provider": "ttml"
    }
  ]
}`}</code></pre>

  <h3>Response fields</h3>
  <table>
    <thead>
      <tr>
        <th>Field</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>total_keys</code></td>
        <td>Number of cached lyrics keys that match the filters</td>
      </tr>
      <tr>
        <td><code>matched_keys</code></td>
        <td>Number of keys in this response (at most <code>limit</code>)</td>
      </tr>
      <tr>
        <td><code>limit</code></td>
        <td>The limit that was applied</td>
      </tr>
      <tr>
        <td><code>keys</code></td>
        <td>Keys in alphabetical order. <code>size</code> is the size of the stored lyrics in bytes.</td>
      </tr>
    </tbody>
  </table>
  <p>Negative cache entries are not listed.</p>

  <h2>GET /cache/debug</h2>
