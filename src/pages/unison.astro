---
import CodeTabs from '../components/CodeTabs.astro';
import DocsLayout from '../layouts/DocsLayout.astro';
import type { CodeLanguage } from '../codeLanguages';

const BASE_URL = 'https://unison.boidu.dev';
const VIDEO_URL = `${BASE_URL}/lyrics?v=Ugr4KKK_SqY`;
const SONG_ARTIST_URL = `${BASE_URL}/lyrics?song=Explorer&artist=Justice`;
const ISRC_URL = `${BASE_URL}/lyrics?isrc=FR8EU2300090`;
const PROVIDER_ID_URL = `${BASE_URL}/lyrics?apple_music=1724935872`;
const SEARCH_URL = `${BASE_URL}/lyrics/search?q=explorer+justice`;
const VARIANTS_URL = `${BASE_URL}/lyrics/variants/Ugr4KKK_SqY?limit=5`;

function fetchTabs(url: string): { language: CodeLanguage; code: string }[] {
  return [
    { language: 'curl', code: `curl "${url}"` },
    { language: 'javascript', code: `const res = await fetch("${url}")\nconst { success, data } = await res.json()` },
    { language: 'python', code: `import requests\n\nbody = requests.get("${url}").json()` },
    {
      language: 'go',
      code: `res, err := http.Get("${url}")\nif err != nil {\n    log.Fatal(err)\n}\ndefer res.Body.Close()\nbody, _ := io.ReadAll(res.Body)`,
    },
    { language: 'rust', code: `let body = reqwest::blocking::get(\n    "${url}",\n)?\n.text()?;` },
  ];
}

const VIDEO_RESPONSE = `{
  "success": true,
  "data": {
    "id": 13529,
    "videoId": "Ugr4KKK_SqY",
    "song": "Explorer",
    "artist": "Justice, Connan Mockasin",
    "album": "Hyperdrama",
    "isrc": "FR8EU2300090",
    "format": "ttml",
    "syncType": "richsync",
    "language": "en",
    "score": 42,
    "voteCount": 47,
    "confidence": "high",
    "lyrics": "<tt xmlns=\\"http://www.w3.org/ns/ttml\\"> ... </tt>"
  }
}`;

const SEARCH_RESPONSE = `{
  "success": true,
  "data": [
    {
      "id": 13529,
      "videoId": "Ugr4KKK_SqY",
      "song": "Explorer",
      "artist": "Justice, Connan Mockasin",
      "format": "ttml",
      "syncType": "richsync",
      "confidence": "high",
      "matchScore": 0.98
    }
  ]
}`;

const CACHE_TABS: { language: CodeLanguage; code: string }[] = [
  {
    language: 'curl',
    code: `curl -i "${VIDEO_URL}" \\\n  -H 'If-None-Match: <the ETag you saved>'`,
  },
  {
    language: 'javascript',
    code: `const saved = store.get(videoId) // { etag, data } from an earlier fetch

const res = await fetch(\`${BASE_URL}/lyrics?v=\${videoId}\`, {
  headers: saved ? { "If-None-Match": saved.etag } : {},
})

if (res.status === 304) {
  render(saved.data)
} else if (res.ok) {
  const { data } = await res.json()
  store.set(videoId, { etag: res.headers.get("ETag"), data })
  render(data)
}`,
  },
];

const PROVIDER_ID_RESPONSE = `{
  "success": true,
  "data": {
    "id": 13529,
    "videoId": "Ugr4KKK_SqY",
    "song": "Explorer",
    "artist": "Justice, Connan Mockasin",
    "isrc": "FR8EU2300090",
    "format": "ttml",
    "syncType": "richsync",
    "matchedBy": "isrc",
    "lyrics": "<tt xmlns=\\"http://www.w3.org/ns/ttml\\"> ... </tt>"
  }
}`;

const LOOKUP_PENDING_RESPONSE = `{
  "success": false,
  "error": "Lookup pending",
  "code": "LOOKUP_PENDING",
  "hint": "We're still matching this track. Try again in a few seconds."
}`;

const ERROR_RESPONSE = `{
  "success": false,
  "error": "Not found",
  "code": "NOT_FOUND",
  "hint": "No lyrics matched that lookup yet."
}`;
---

<DocsLayout title="Unison">
  <p>
    <a href="https://unison.boidu.dev" target="_blank" rel="noopener noreferrer">Unison</a> is a public
    database of community-synced lyrics, the community-fed source Better Lyrics reads from. Each entry is
    keyed on a <code>videoId</code>. Reading from it needs no key and no sign-in. Every
    <code>/lyrics</code> response is wrapped as <code>{`{ success, data }`}</code>, so check
    <code>success</code> before you touch <code>data</code>. Reads are rate limited to 600 requests per
    minute per IP.
  </p>

  <h2>Base URL</h2>
  <pre><code class="language-bash">{BASE_URL}</code></pre>

  <h2>Quick start</h2>
  <p>
    If you have a video id, one call gets you the top-ranked lyrics for it. The synced text is in
    <code>data.lyrics</code> and its format is in <code>data.format</code>.
  </p>
  <CodeTabs tabs={[
    { language: 'curl', code: `curl "${VIDEO_URL}"` },
    { language: 'javascript', code: `const res = await fetch("${VIDEO_URL}")
const { success, data } = await res.json()

if (success) {
  // data.format is "ttml" | "lrc" | "plain"
  // data.lyrics holds the synced text in that format
  render(data.lyrics, data.format)
}` },
    { language: 'python', code: `import requests

res = requests.get("${BASE_URL}/lyrics", params={"v": "Ugr4KKK_SqY"})
body = res.json()

if body["success"]:
    data = body["data"]
    # data["format"] is "ttml" | "lrc" | "plain"
    render(data["lyrics"], data["format"])` },
    { language: 'go', code: `res, err := http.Get("${VIDEO_URL}")
if err != nil {
    log.Fatal(err)
}
defer res.Body.Close()

// body.data.lyrics holds the synced text in body.data.format
body, _ := io.ReadAll(res.Body)
fmt.Println(string(body))` },
    { language: 'rust', code: `// reqwest = { version = "0.12", features = ["blocking"] }
let body = reqwest::blocking::get(
    "${VIDEO_URL}",
)?
.text()?;

// body.data.lyrics holds the synced text in body.data.format
println!("{body}");` },
  ]} />

  <h2>Attribution</h2>
  <p>
    Any app that shows Unison lyrics must credit Unison and the person who submitted them. The credit can
    sit at the end of the lyrics; it does not have to stay on screen. Apps integrating Unison have until
    <strong>7 February 2027</strong> to add it.
  </p>

  <h3>If you use the API</h3>
  <p>
    Show <code>Lyrics from Unison</code>, linked to
    <code>https://unison.betterlyrics.org/song/&lt;videoId&gt;</code>, and the submitter's
    <code>submitter.displayName</code>, linked to
    <code>https://unison.betterlyrics.org/curator/&lt;submitter.keyId&gt;</code>. Every lyric response
    carries both.
  </p>
  <p>After the deadline, apps that don't show the credit may lose access to the API.</p>

  <h3>If you use the database dump</h3>
  <p>
    The <a href="https://github.com/better-lyrics/unison#database-dump" target="_blank" rel="noopener noreferrer">dump</a> license (ODbL) requires the
    Unison credit. The dump has no submitter column, so the submitter credit is our request rather than a
    license term. Get the submitter with <code>GET /lyrics/&lt;id&gt;</code>, or link the lyric instead:
    <code>https://unison.betterlyrics.org/song/&lt;video_id&gt;?variantId=&lt;id&gt;</code> shows who
    submitted it.
  </p>

  <h3>Good examples</h3>
  <ul>
    <li>Under the last line: <strong>Lyrics from Unison · submitted by boidu</strong>, with both parts linked.</li>
    <li>In an always visible spot next to the lyrics, or in a footer or credits row that opens with them.</li>
  </ul>

  <h3>Bad examples</h3>
  <ul>
    <li>No credit at all.</li>
    <li>"Unison" with no link.</li>
    <li>Unison credited, but the submitter left out.</li>
    <li>The credit only on an About or settings page.</li>
    <li>Unison lyrics labelled as another provider's.</li>
  </ul>

  <h3>Why?</h3>
  <p>
    Every lyric on Unison was submitted by someone in the community, for free. Seeing their name next to
    their work is how they get thanked, and it helps bring in the next contributor. The link matters as much
    as the name: a listener who spots a wrong line follows it to the song page to vote, report or submit a
    fix, so the lyrics in your app get better over time.
  </p>

  <h2>Fetch by video</h2>
  <p>
    <code>GET /lyrics?v=&lt;videoId&gt;</code> returns the single best version for that video. The
    fields you need to render are <code>lyrics</code>, <code>format</code>, and <code>syncType</code>;
    <code>confidence</code> tells you how much the community has vetted it. A miss returns
    <code>404</code>.
  </p>
  <pre><code class="language-json">{VIDEO_RESPONSE}</code></pre>

  <h2>Fetch by song and artist</h2>
  <p>
    No video id? Look up by <code>song</code> and <code>artist</code> instead. Both are matched
    case-insensitively, and <code>artist</code> only has to share one credited name, so sending just the
    main artist works for a song with several. Add <code>album</code> or <code>duration</code> (seconds,
    matched within a small tolerance) when a title has more than one recording.
  </p>
  <CodeTabs tabs={fetchTabs(SONG_ARTIST_URL)} />

  <h2>Fetch by ISRC</h2>
  <p>
    <code>GET /lyrics?isrc=&lt;isrc&gt;</code> returns the best version for a recording. Case and hyphens
    do not matter. Pass <code>song</code> and <code>artist</code> too and an unknown ISRC falls back to
    them.
  </p>
  <CodeTabs tabs={fetchTabs(ISRC_URL)} />

  <h2>Fetch by Spotify, Apple Music or Tidal id</h2>
  <p>
    <code>spotify</code>, <code>apple_music</code> and <code>tidal</code> take a track id, not a link.
    Unison turns it into an ISRC with
    <a href="https://link.binimum.org" target="_blank" rel="noopener noreferrer">BiniLink</a> and looks
    that up. <code>matchedBy</code> in the response says how it matched. A <code>linked_video</code> match
    can be a different release, so its timing may drift.
  </p>
  <p>
    A lookup with a new id can return <code>503</code> with <code>Retry-After</code> while BiniLink is
    still matching it or is down. Retry a few times, then give up.
  </p>
  <CodeTabs tabs={fetchTabs(PROVIDER_ID_URL)} />
  <pre><code class="language-json">{PROVIDER_ID_RESPONSE}</code></pre>
  <pre><code class="language-json">{LOOKUP_PENDING_RESPONSE}</code></pre>

  <h2>Which lookup to use</h2>
  <p>
    Use <code>v</code> when you can: it's the fastest lookup. Without <code>v</code>, Unison falls back to
    <code>isrc</code>, then Spotify / Apple Music / Tidal id, then <code>song</code> + <code>artist</code>,
    and returns the first match. The fallbacks can take longer to answer.
  </p>

  <h2>Search</h2>
  <p>
    <code>GET /lyrics/search?q=&lt;text&gt;</code> is for discovery. It returns ranked candidates with a
    <code>matchScore</code> but no lyric body, so pick the <code>videoId</code> you want and fetch it
    with <code>/lyrics?v=</code>. Passing <code>song</code> and <code>artist</code> instead of
    <code>q</code> runs an exact match and does include the full records. Use <code>limit</code> to cap
    results.
  </p>
  <CodeTabs tabs={fetchTabs(SEARCH_URL)} />
  <pre><code class="language-json">{SEARCH_RESPONSE}</code></pre>

  <h2>Other versions</h2>
  <p>
    A video can have several submitted versions. <code>GET /lyrics/variants/:videoId</code> lists them
    all, best-ranked first (up to 50), so you can offer alternatives if the default is not the one you
    want. <code>GET /lyrics/:id</code> fetches one specific version by its numeric id.
  </p>
  <CodeTabs tabs={fetchTabs(VARIANTS_URL)} />

  <h2>Caching</h2>
  <p>
    Keep the lyrics you fetch and check them before you download them again. A check is cheaper than a
    full download for both Unison and your app, and your copy stays in sync with edits and new versions.
  </p>
  <p>
    Every <code>GET /lyrics</code> lookup sends an <code>ETag</code>. Save it with the lyric and send it
    back as <code>If-None-Match</code>. If the lyric is the same, Unison answers
    <code>304 Not Modified</code> with no body, and you use the copy you have.
  </p>
  <CodeTabs tabs={CACHE_TABS} />
  <p>
    The tag changes when someone edits the lyric or its song details, when the submitter changes their
    name, or when another version moves to the top. Votes, confidence and the submitter's stats can change
    under the same tag, so a saved copy may show old numbers.
  </p>

  <h2>Formats</h2>
  <p>
    The <code>format</code> field tells you how to read <code>lyrics</code>, and <code>syncType</code>
    tells you how precise the timing is.
  </p>
  <ul>
    <li>
      <code>ttml</code> is timed XML, the richest format. Pair it with <code>syncType</code>
      <code>richsync</code> for syllable-level timing or <code>linesync</code> for per-line timing.
    </li>
    <li><code>lrc</code> is timestamped lines, the classic karaoke format.</li>
    <li><code>plain</code> is unsynced text, with <code>syncType</code> <code>plain</code>.</li>
  </ul>

  <h2>Errors and limits</h2>
  <p>
    Failed <code>/lyrics</code> calls keep the envelope with <code>success: false</code> plus a
    <code>code</code> and a human-readable <code>error</code> and <code>hint</code>. Common ones:
  </p>
  <ul>
    <li><code>404</code> when nothing matches.</li>
    <li><code>400</code> when the query has no way to name the song.</li>
    <li>
      <code>503 LOOKUP_PENDING</code> with <code>Retry-After</code> while BiniLink matches a new track id.
      Retry a few times, then give up.
    </li>
  </ul>
  <p>Stay under 600 requests per minute per IP or you get <code>429</code>.</p>
  <pre><code class="language-json">{ERROR_RESPONSE}</code></pre>
</DocsLayout>
