---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { renderStylingDoc, stylingDocSourceUrl } from '../../stylingDocs';

const html = await renderStylingDoc('STYLING.md');
---

<DocsLayout title="Styling guide">
  <p class="note">
    Synced from <a href={stylingDocSourceUrl('STYLING.md')} target="_blank" rel="noopener noreferrer">STYLING.md</a> in the Better Lyrics repository when this site is built.
  </p>
  <Fragment set:html={html} />
</DocsLayout>
